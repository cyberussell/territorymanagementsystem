# Copy to .env.local and fill in from your TMS Supabase project's Settings → API.
# See territory-management-system/SETUP.md.

NEXT_PUBLIC_TMS_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_TMS_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Server-only — bypasses RLS. Never prefix with NEXT_PUBLIC_ or expose to the browser.
TMS_SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx
